<div class="post-container">
  <%= form_with model: tweet, local: true do |f| %>
    <div class="field">
      <%= f.label :場所名 %>
      <%= f.text_field :name, :size => 30 %>
    </div>

    <div class="field">
      <%= f.label :エリア %>
      <%= f.select :address,
        [
          ["札幌", "札幌"],
          ["仙台", "仙台"],
          ["東京", "東京"],
          ["名古屋", "名古屋"],
          ["大阪", "大阪"],
          ["広島", "広島"],
          ["福岡", "福岡"],
          ["那覇", "那覇"]
        ], include_blank: "選択して下さい" %>
    </div>

    <div class="field">
      <%= f.label :画像 %>
      <%= f.file_field :image %>
    </div>

    <div class="field">
      <%= f.label :コメント %>
      <%= f.text_area :comment, :size => "30x2" %>
    </div>

    <div class="field">
  <%= f.label :kinds_place, "ジャンル（複数選択可）" %><br>
  <% ["海", "自然", "温泉", "夜景", "グルメ"].each do |genre| %>
    <label>
      <%= check_box_tag "tweet[kinds_place][]", genre, f.object.kinds_place_array.include?(genre) %>
      <%= genre %>
    </label>
  <% end %>
  <%= hidden_field_tag "tweet[kinds_place][]", "" %>
</div>

<div class="field">
  <%= f.label :target, "対象（複数選択可）" %><br>
  <% ["男同士", "女同士", "男女混合", "デート", "家族旅行"].each do |t| %>
    <label>
      <%= check_box_tag "tweet[target][]", t, f.object.target_array.include?(t) %>
      <%= t %>
    </label>
  <% end %>
  <%= hidden_field_tag "tweet[target][]", "" %>
</div>

 <div class="field">
  <%= f.label :season, "おすすめの季節（複数選択可）" %><br>
  <% ["春", "夏", "秋", "冬"].each do |s| %>
    <label>
      <%= check_box_tag "tweet[season][]", s, f.object.season_array.include?(s) %>
      <%= s %>
    </label>
  <% end %>
  <%= hidden_field_tag "tweet[season][]", "" %>
</div>

<div class="field">
  <%= f.label :indoor_outdoor, "屋内・屋外" %>
  <%= f.select :indoor_outdoor,
    [
      ["屋内", "屋内"],
      ["屋外", "屋外"],
      ["どちらもあり", "どちらもあり"]
    ], include_blank: "選択して下さい" %>
</div>

   

    <%= f.submit %>
  <% end %>
  <%= link_to "一覧に戻る", tweets_path %>
</div>