<div class="post-container">
  <%= form_with model: tweet, local: true do |f| %>
    <div class="field">
      <%= f.label :場所名 %>
      <%= f.text_field :name, :size => 30 %>
    </div>

    <div class="field">
  <%= f.label :address, "エリア" %>
  <%= render "shared/japan_map", field_name: "tweet[address]", selected_value: f.object.address, map_id: "tweet_map" %>
</div>

    <div class="field">
      <%= f.label :画像 %>
      <%= f.file_field :image %>
    </div>

    <div class="field">
      <%= f.label :コメント %>
      <%= f.text_area :comment, :size => "30x2" %>
    </div>

    <div class="field">
      <%= f.label :kinds_place, "ジャンル（複数選択可）" %>
      <div class="icon-checkbox-group">
        <% ["海", "自然", "温泉", "夜景", "グルメ"].each_with_index do |genre, i| %>
          <label class="icon-checkbox">
            <%= check_box_tag "tweet[kinds_place][]", genre, f.object.kinds_place_array.include?(genre), id: "kinds_place_#{i}" %>
            <span class="icon-circle"><%= car_icon_svg %></span>
            <span class="icon-label-text"><%= genre %></span>
          </label>
        <% end %>
      </div>
      <%= hidden_field_tag "tweet[kinds_place][]", "" %>
    </div>

    <div class="field">
      <%= f.label :target, "対象（複数選択可）" %>
      <div class="icon-checkbox-group">
        <% ["男同士", "女同士", "男女混合", "デート", "家族旅行"].each_with_index do |t, i| %>
          <label class="icon-checkbox">
            <%= check_box_tag "tweet[target][]", t, f.object.target_array.include?(t), id: "target_#{i}" %>
            <span class="icon-circle"><%= car_icon_svg %></span>
            <span class="icon-label-text"><%= t %></span>
          </label>
        <% end %>
      </div>
      <%= hidden_field_tag "tweet[target][]", "" %>
    </div>

    <div class="field">
      <%= f.label :season, "おすすめの季節（複数選択可）" %>
      <div class="icon-checkbox-group">
        <% ["春", "夏", "秋", "冬"].each_with_index do |s, i| %>
          <label class="icon-checkbox">
            <%= check_box_tag "tweet[season][]", s, f.object.season_array.include?(s), id: "season_#{i}" %>
            <span class="icon-circle"><%= car_icon_svg %></span>
            <span class="icon-label-text"><%= s %></span>
          </label>
        <% end %>
      </div>
      <%= hidden_field_tag "tweet[season][]", "" %>
    </div>

    <div class="field">
      <%= f.label :indoor_outdoor, "屋内・屋外" %>
      <div class="icon-radio-group">
        <% [["屋内", "屋内"], ["屋外", "屋外"], ["どちらもあり", "どちらもあり"]].each_with_index do |(label, value), i| %>
          <label class="icon-checkbox">
            <%= f.radio_button :indoor_outdoor, value, id: "indoor_outdoor_#{i}" %>
            <span class="icon-circle"><%= car_icon_svg %></span>
            <span class="icon-label-text"><%= label %></span>
          </label>
        <% end %>
      </div>
    </div>

    <%= f.submit "投稿する" %>
  <% end %>
  <%= link_to "一覧に戻る", tweets_path, class: "back-button" %>
</div>