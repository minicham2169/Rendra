<div class="hero">
<h2 class="hero-title">レンタカーでドライブに行くあなたのためのサイト</h2>
</div>



<h3>投稿を検索</h3>
 <%= form_tag({controller:"tweets",action:"index"}, method: :get) do %>
   <%= text_field_tag :search %>
   <%= submit_tag '検索する'  %>
 <% end %>

<div class="banner-group">
  <%= link_to "ドライブ行き先診断", diagnoses_index_path, class: "banner-link" %>
  <%= link_to "新規投稿へ", new_tweet_path, class: "banner-link" %>
</div>

<div class="tweets-container">
  <% @tweets.each do |t| %>
    <div class="tweet">
      <% if t.image.attached? %>
        <%= image_tag t.image, size: '250x200' %>
      <% end %>
      <h3 class="tweet-title"><%= link_to t.name, tweet_path(t.id) %></h3>

      <div class="tweet-info">
        <div class="tweet-row">
          <span class="tweet-label">エリア</span>
          <span class="tweet-value"><%= t.address %></span>
        </div>
        <div class="tweet-row">
          <span class="tweet-label">コメント</span>
          <span class="tweet-value"><%= t.comment %></span>
        </div>
        <div class="tweet-row">
          <span class="tweet-label">ジャンル</span>
          <span class="tweet-value"><%= t.kinds_place %></span>
        </div>
        <div class="tweet-row">
          <span class="tweet-label">対象</span>
          <span class="tweet-value"><%= t.target %></span>
        </div>
        <div class="tweet-row">
          <span class="tweet-label">投稿者</span>
          <span class="tweet-value"><%= t.user.name %></span>
        </div>
      </div>

      <div class="tweet-actions">
        <% if user_signed_in? %>
          <% if current_user.already_liked?(t) %>
            <%= link_to tweet_like_path(id: t.id, tweet_id: t.id), data: { turbo_method: :delete } do %>
              <i class="fas fa-heart"></i><%= t.likes.count %>
            <% end %>
          <% else %>
            <%= link_to tweet_likes_path(id: t.id, tweet_id: t.id), data: { turbo_method: :post } do %>
              <i class="far fa-heart"></i><%= t.likes.count %>
            <% end %>
          <% end %>
        <% else %>
          <i class="far fa-heart"></i><%= t.likes.count %>
        <% end %>

        <%= link_to "詳細へ", tweet_path(t.id) %>
        <%= link_to "編集する", edit_tweet_path(t.id) %>
        <%= link_to "削除する", tweet_path(t.id), data: { turbo_method: :delete } %>
      </div>
    </div>
  <% end %>
</div>