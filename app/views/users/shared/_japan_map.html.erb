<div class="japan-map-wrapper" id="<%= map_id %>-wrapper">
  <input type="hidden" name="<%= field_name %>" id="<%= map_id %>-input" value="<%= selected_value %>">
  <p class="map-selected-text" id="<%= map_id %>-display">
    <%= selected_value.present? ? "選択中：#{selected_value}" : "地図から選んでください" %>
  </p>
  <svg viewBox="0 0 400 520" class="japan-map-svg" xmlns="http://www.w3.org/2000/svg">
    <!-- 北海道 -->
    <path d="M270,30 L310,25 L340,40 L350,70 L330,90 L300,95 L280,110 L260,90 L255,60 Z" fill="#d0e4f7" stroke="#8bb0d6" stroke-width="1"/>
    <!-- 本州 -->
    <path d="M280,115 L300,130 L310,160 L320,190 L310,220 L300,250 L280,270 L260,290 L240,300 L220,310 L200,320 L180,325 L160,330 L140,325 L130,310 L140,295 L160,280 L180,270 L200,250 L220,230 L240,200 L260,170 L270,140 Z" fill="#d0e4f7" stroke="#8bb0d6" stroke-width="1"/>
    <!-- 四国 -->
    <path d="M175,340 L200,335 L220,340 L215,355 L190,360 L170,350 Z" fill="#d0e4f7" stroke="#8bb0d6" stroke-width="1"/>
    <!-- 九州 -->
    <path d="M100,320 L125,315 L135,330 L130,360 L115,380 L95,375 L85,350 L90,330 Z" fill="#d0e4f7" stroke="#8bb0d6" stroke-width="1"/>
    <!-- 沖縄 -->
    <ellipse cx="95" cy="475" rx="15" ry="8" fill="#d0e4f7" stroke="#8bb0d6" stroke-width="1"/>

    <!-- 都市マーカー -->
    <% cities = [
      { name: "札幌", x: 295, y: 60 },
      { name: "仙台", x: 305, y: 175 },
      { name: "東京", x: 300, y: 245 },
      { name: "名古屋", x: 255, y: 285 },
      { name: "大阪", x: 215, y: 310 },
      { name: "広島", x: 155, y: 320 },
      { name: "福岡", x: 110, y: 345 },
      { name: "那覇", x: 95, y: 475 }
    ] %>

    <% cities.each do |city| %>
      <g class="city-marker" data-city="<%= city[:name] %>" data-map="<%= map_id %>" onclick="selectCity(this)" style="cursor: pointer;">
        <circle cx="<%= city[:x] %>" cy="<%= city[:y] %>" r="12" fill="#b8c6d9" stroke="#ffffff" stroke-width="2" class="city-dot"/>
        <text x="<%= city[:x] %>" y="<%= city[:y] + 4 %>" text-anchor="middle" fill="white" font-size="8" font-weight="bold" style="pointer-events: none;"><%= city[:name].chars.first %></text>
        <text x="<%= city[:x] + 18 %>" y="<%= city[:y] + 5 %>" fill="#1a3a5c" font-size="12" font-weight="bold" style="pointer-events: none;"><%= city[:name] %></text>
      </g>
    <% end %>
  </svg>
</div>

<script>
  function selectCity(el) {
    var mapId = el.dataset.map;
    var city = el.dataset.city;
    var wrapper = document.getElementById(mapId + '-wrapper');
    var input = document.getElementById(mapId + '-input');
    var display = document.getElementById(mapId + '-display');

    wrapper.querySelectorAll('.city-dot').forEach(function(dot) {
      dot.setAttribute('fill', '#b8c6d9');
    });

    el.querySelector('.city-dot').setAttribute('fill', '#1e90ff');
    input.value = city;
    display.textContent = '選択中：' + city;
  }
</script>