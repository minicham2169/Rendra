<div class="post-container">
  <h1 class="title">アカウント編集</h1>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
    <%= render "users/shared/error_messages", resource: resource %>

    <div class="field">
      <%= f.label :name, "名前" %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name" %>
    </div>

    <div class="field">
      <%= f.label :image, "画像" %>
      <%= f.file_field :image %>
    </div>

    <div class="field">
      <%= f.label :profile, "プロフィール" %>
      <%= f.text_area :profile, autofocus: true %>
    </div>

    <div class="field">
      <%= f.label :email, "メールアドレス" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email",class:"wide-input" %>
    </div>

    <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
      <p class="field-note">確認待ちのメールアドレス：<%= resource.unconfirmed_email %></p>
    <% end %>

    <div class="field">
      <%= f.label :password, "パスワード" %>
      <p class="field-note">変更しない場合は空欄のままにしてください</p>
      <%= f.password_field :password, autocomplete: "new-password" %>
      <% if @minimum_password_length %>
        <p class="field-note">最低 <%= @minimum_password_length %> 文字以上</p>
      <% end %>
    </div>

    <div class="field">
      <%= f.label :password_confirmation, "パスワード確認" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password" %>
    </div>

    <div class="field">
      <%= f.label :current_password, "現在のパスワード" %>
      <p class="field-note">変更を確定するには現在のパスワードが必要です</p>
      <%= f.password_field :current_password, autocomplete: "current-password" %>
    </div>

    <%= f.submit "更新する", class: "small-button" %>
  <% end %>

  <h3 class="title">アカウント削除</h3>
  <div class="cancel-account">
    <p>退会をご希望の場合はこちら</p>
    <%= button_to "アカウントを削除する", registration_path(resource_name), data: { confirm: "本当によろしいですか？", turbo_confirm: "本当によろしいですか？" }, method: :delete, class: "danger-button" %>
  </div>

  <%= link_to "戻る", :back, class: "back-button" %>
</div>